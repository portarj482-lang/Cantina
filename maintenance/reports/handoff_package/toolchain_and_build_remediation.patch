-++++              stroke="#DC2626"
-++++              strokeWidth="1.5"
-++++              strokeLinecap="round"
-++++            />
-++++            <path
-++++              d="M12 16.5h.01"
-++++              stroke="#DC2626"
-++++              strokeWidth="1.5"
-++++              strokeLinecap="round"
-++++            />
-++++            <path
-++++              d="M12 3.5l9 16H3l9-16Z"
-++++              stroke="#DC2626"
-++++              strokeWidth="1.5"
-++++              strokeLinejoin="round"
-++++            />
-++++          </svg>
-++++        ) : (
-++++          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
-++++            <path
-++++              d="M16.6666 5L7.49996 14.1667L3.33329 10"
-++++              stroke="#16A34A"
-++++              strokeWidth="1.5"
