{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FindingContract",
  "description": "Governs finding identity, detector attribution, source location, severity, exploitability hypothesis, evidence references, counterevidence, verification level, and uncertainty.",
  "type": "object",
  "required": [
    "schema_version",
    "finding_id",
    "source_revision",
    "detector",
    "classification",
    "verification",
    "evidence_refs",
    "counterevidence_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.0.0"]
    },
    "finding_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "detector": {
      "type": "object",
      "required": ["name", "rule_id", "tool_version"],
      "properties": {
        "name": { "type": "string" },
        "rule_id": { "type": "string" },
        "tool_version": { "type": ["string", "null"] }
      }
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "start_line": { "type": "integer" },
        "end_line": { "type": "integer" },
        "snippet": { "type": "string" }
      }
    },
    "severity": {
      "type": "object",
      "properties": {
        "scanner_severity": { "type": "string" },
        "assessed_severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]
        }
      }
    },
    "exploitability_hypothesis": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "candidate",
        "triaged",
        "reproduced",
        "independently_verified",
        "rejected",
        "inconclusive"
      ]
    },
    "verification": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "refuted",
        "inconclusive"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "counterevidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
