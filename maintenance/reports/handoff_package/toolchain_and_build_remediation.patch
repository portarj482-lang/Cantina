-++++        .unwrap_or_else(|| "Unknown".to_string());
-++++    let actual = check
-++++        .actual
-++++        .map(|a| a.to_string())
-++++        .unwrap_or_else(|| "Unknown".to_string());
-++++
-++++    println!(
-++++        "❌ MISMATCH for {} ({}): \n\tFile: {}\n\tChain: {}",
