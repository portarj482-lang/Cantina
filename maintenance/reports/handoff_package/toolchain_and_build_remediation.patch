-+        method: "wallet_connect",
-+        params: [
-+          {
-+            version: "1",
-+            capabilities: {
-+              signInWithEthereum: {
-+                nonce,
-+                chainId: "0x2105",
-+              },
-+            },
-+          },
-+        ],
-+      })) as {
-+        accounts: Array<{
-+          address: string;
-+          capabilities: {
-+            signInWithEthereum: { message: string; signature: string };
-+          };
-+        }>;
-+      };
-+      const { address } = response.accounts[0];
-+      const { message, signature } =
-+        response.accounts[0].capabilities.signInWithEthereum;
-+
-+      // Verify with backend
