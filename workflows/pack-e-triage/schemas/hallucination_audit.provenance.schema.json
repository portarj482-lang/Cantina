{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HallucinationAuditProvenance",
  "type": "object",
  "required": [
    "source_files",
    "processed_count",
    "errors",
    "pinned_commit",
    "timestamp"
  ],
  "properties": {
    "source_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processed_count": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "pinned_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
