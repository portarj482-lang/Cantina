-++++      // Type assertion for embedded wallet provider access
-++++      const provider = await (embeddedWallet as any).getProvider();
-++++      const rawHash =
-++++        "0x6503b027a625549f7be691646404f275f149d17a119a6804b855bac3030037aa";
