{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cantina:case-state:v1",
  "title": "Cantina immutable case-state snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "phase", "sequence", "parent_digest", "nodes", "edges", "digest"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounty", "scope_sha256", "source_commit"],
      "properties": {
        "bounty": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "phase": {"enum": ["OPEN", "STABILIZED", "SEALED"]},
    "sequence": {"type": "integer", "minimum": 0},
    "parent_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"},
          "kind": {"enum": ["HYPOTHESIS", "FINDING", "SOURCE", "TOOL", "POC", "REPORT", "NOTE"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "relation"],
        "properties": {
          "source": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"},
          "target": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"},
          "relation": {"enum": ["SUPPORTS", "REFUTES", "DERIVED_FROM", "DEPENDS_ON"]}
        }
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
