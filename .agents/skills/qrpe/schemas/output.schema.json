{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QRPEOutputSchema",
  "type": "object",
  "required": ["run_id", "mode", "status", "timestamp", "findings", "actions_taken"],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["VERIFIED_COMPLETE", "PARTIALLY_VERIFIED", "BLOCKED", "FAILED", "APPROVAL_REQUIRED"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "evidence", "affected_path"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
          "evidence": { "type": "string" },
          "affected_path": { "type": "string" },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "actions_taken": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts_created": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
