-++++                strokeWidth={2}
-++++                d="M19 9l-7 7-7-7"
-++++              />
-++++            </svg>
-++++          </div>
-++++        </div>
-++++      </div>
-++++    </Section>
-++++  );
-++++};
-++++
-++++export default WalletActions;
