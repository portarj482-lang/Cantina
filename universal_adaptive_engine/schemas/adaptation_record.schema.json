{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.dev/schemas/adaptation_record.schema.json",
  "title": "Canonical Adaptation Record",
  "description": "Represents an architecture adaptation proposal, evaluation, and admission decision record.",
  "type": "object",
  "required": [
    "candidate_id",
    "candidate_type",
    "license",
    "intended_capability",
    "compatibility",
    "protected_core_changed",
    "shared_contracts_changed",
    "approval_required",
    "decision",
    "rationale"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique identifier for the candidate adaptation (e.g. ADAPT-0001)"
    },
    "candidate_type": {
      "type": "string",
      "enum": [
        "skill",
        "agent",
        "tool",
        "dataset",
        "prompt",
        "service",
        "pattern",
        "adapter"
      ],
      "description": "Category of the adaptation candidate"
    },
    "source_ref": {
      "type": ["string", "null"],
      "description": "Origin repository, URL, or package identifier"
    },
    "version": {
      "type": ["string", "null"],
      "description": "Version string of the candidate"
    },
    "checksum": {
      "type": ["string", "null"],
      "description": "Cryptographic digest (e.g. sha256) of candidate artifacts"
    },
    "license": {
      "type": "string",
      "description": "Software license or permitted use terms"
    },
    "intended_capability": {
      "type": "string",
      "minLength": 1,
      "description": "Specific capability the candidate is intended to provide"
    },
    "compatibility": {
      "type": "object",
      "required": ["contracts", "dependencies", "security", "regressions"],
      "properties": {
        "contracts": {
          "type": "string",
          "enum": ["compatible", "incompatible", "not_checked", "needs_adapter"]
        },
        "dependencies": {
          "type": "string",
          "enum": ["compatible", "incompatible", "not_checked", "missing_dependency"]
        },
        "security": {
          "type": "string",
          "enum": ["passed", "failed", "not_checked", "sandbox_required"]
        },
        "regressions": {
          "type": "string",
          "enum": ["none_observed", "degraded", "not_checked"]
        }
      }
    },
    "baseline_ref": {
      "type": ["string", "null"],
      "description": "Reference identifier of baseline evaluation"
    },
    "candidate_evaluation_ref": {
      "type": ["string", "null"],
      "description": "Reference identifier of candidate evaluation metrics"
    },
    "protected_core_changed": {
      "type": "boolean",
      "description": "Whether protected core policy or permissions are modified"
    },
    "shared_contracts_changed": {
      "type": "boolean",
      "description": "Whether canonical contracts or shared schemas are modified"
    },
    "approval_required": {
      "type": "boolean",
      "description": "Whether human or governance authority approval is required"
    },
    "approval_ref": {
      "type": ["string", "null"],
      "description": "Reference to recorded human approval authorization"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ACCEPTED_FOR_STAGING",
        "ACCEPTED_FOR_PRODUCTION",
        "NEEDS_ADAPTATION",
        "NEEDS_REVIEW",
        "QUARANTINED",
        "REJECTED",
        "DEPRECATED",
        "ROLLED_BACK"
      ],
      "description": "Admission decision"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "description": "Evidence-backed justification for the decision"
    },
    "rollback_ref": {
      "type": ["string", "null"],
      "description": "Reference to documented and tested rollback procedure or commit"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of record creation"
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of last update"
    }
  }
}
