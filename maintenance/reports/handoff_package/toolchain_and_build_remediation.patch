-+  const handleSignInWithBase = async () => {
-+    if (!provider) {
-+      showErrorToast("Base Account SDK not available");
-+      return;
-+    }
-+
-+    try {
-+      setLoading(true);
-+      setVerificationResult(null);
-+
-+      // Get a fresh nonce
