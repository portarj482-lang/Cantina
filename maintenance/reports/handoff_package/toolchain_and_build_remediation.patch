-++++          "0px 4px 10px -2px rgba(16, 24, 40, 0.08), 0px 10px 20px -3px rgba(0, 0, 0, 0.1)",
-++++      }}
-++++    >
-++++      <div className="shrink-0 mt-0.5" aria-hidden>
-++++        {isError ? (
