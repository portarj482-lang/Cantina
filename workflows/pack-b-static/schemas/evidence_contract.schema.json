{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceContract",
  "description": "Governs evidence source, revision, digest, acquisition method, and provenance.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_type",
    "source",
    "revision",
    "digest",
    "acquisition_method",
    "timestamp",
    "provenance",
    "state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.0.0"]
    },
    "evidence_id": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "SOURCE_CODE",
        "STATIC_ANALYSIS_SCAN",
        "EXECUTION_RECEIPT",
        "SARIF_REPORT",
        "TEST_RESULT",
        "CHALLENGE_RESULT",
        "GATE_DECISION"
      ]
    },
    "source": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["sha256", "sha512"] },
        "value": { "type": "string" }
      }
    },
    "acquisition_method": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": ["tool", "tool_version", "run_id"],
      "properties": {
        "tool": { "type": "string" },
        "tool_version": { "type": ["string", "null"] },
        "run_id": { "type": "string" },
        "task_id": { "type": ["string", "null"] },
        "operator": { "type": ["string", "null"] }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "DERIVED",
        "HYPOTHESIS",
        "UNVERIFIED",
        "REFUTED",
        "SUPERSEDED"
      ]
    }
  }
}
