{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cantina Normalized Findings",
  "type": "object",
  "required": ["slug", "normalized_findings", "timestamp", "status"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "normalized_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "classification", "description", "target", "provenance"],
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": ["CONFIRMED", "STATIC_ANALYSIS", "NEEDS_REVIEW", "REJECTED"]
          },
          "description": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": ["repository", "slug"],
            "properties": {
              "repository": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "revision": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": ["string", "null"]
              },
              "line_start": {
                "type": ["integer", "null"]
              },
              "line_end": {
                "type": ["integer", "null"]
              },
              "contract_or_program": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["tool"],
              "properties": {
                "tool": {
                  "type": "string"
                },
                "tool_version": {
                  "type": ["string", "null"]
                },
                "source_report": {
                  "type": ["string", "null"]
                },
                "source_finding_id": {
                  "type": ["string", "null"]
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array"
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "method": {
                "type": ["string", "null"]
              },
              "reproduction": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          },
          "deduplication": {
            "type": "object",
            "properties": {
              "group_id": {
                "type": ["string", "null"]
              },
              "rationale": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "timestamp": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["NORMALIZATION_COMPLETE"]
    }
  },
  "additionalProperties": false
}
