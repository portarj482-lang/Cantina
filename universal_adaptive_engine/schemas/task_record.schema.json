{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.dev/schemas/task_record.schema.json",
  "title": "Canonical Task Record",
  "description": "Represents an individual unit of work tracked in the Universal Adaptive task ledger.",
  "type": "object",
  "required": [
    "task_id",
    "goal",
    "status",
    "owner",
    "dependencies",
    "expected_artifacts",
    "acceptance_criteria",
    "risk_level",
    "attempt_count",
    "evidence_refs",
    "tests",
    "limitations",
    "next_action"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique identifier for the task (e.g. TASK-0001)"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "One clear, measurable outcome for this task"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "READY",
        "RUNNING",
        "WAITING",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "VERIFYING",
        "COMPLETED_WITH_LIMITATIONS",
        "COMPLETED_VERIFIED"
      ],
      "description": "Current lifecycle state of the task"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Owner of the task state, typically 'orchestrator'"
    },
    "assigned_role": {
      "type": ["string", "null"],
      "description": "Specialist agent role assigned to execute this task"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Task IDs that must complete before this task can be READY"
    },
    "inputs": {
      "type": "array",
      "items": { "type": ["string", "object"] },
      "description": "Input data, configuration, or file references"
    },
    "expected_artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Artifact paths or descriptions expected upon completion"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit criteria required to pass verification"
    },
    "permissions_required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "System or tool permissions needed to execute"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Risk assessment for changes introduced by this task"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of execution attempts"
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Identifiers of evidence records supporting task completion"
    },
    "blocker": {
      "type": ["object", "null"],
      "description": "Diagnosis details if task is currently BLOCKED",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "MISSING_CONTEXT",
            "INVALID_INPUT",
            "TOOL_UNAVAILABLE",
            "PERMISSION_DENIED",
            "POLICY_BLOCK",
            "DEPENDENCY_FAILURE",
            "RESOURCE_LIMIT",
            "ENVIRONMENT_FAILURE",
            "TEST_FAILURE",
            "UNKNOWN"
          ]
        },
        "message": { "type": "string" },
        "recoverable": { "type": "boolean" },
        "diagnosis": { "type": "string" },
        "recovery_action": { "type": "string" },
        "stop_condition": { "type": "string" }
      },
      "required": ["category", "message", "recoverable"]
    },
    "tests": {
      "type": "object",
      "required": ["passed", "failed", "skipped", "not_run"],
      "properties": {
        "passed": { "type": "array", "items": { "type": ["string", "object"] } },
        "failed": { "type": "array", "items": { "type": ["string", "object"] } },
        "skipped": { "type": "array", "items": { "type": ["string", "object"] } },
        "not_run": { "type": "array", "items": { "type": ["string", "object"] } }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known omissions, constraints, or untested aspects"
    },
    "next_action": {
      "type": "string",
      "description": "Immediate subsequent step or handoff destination"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of task creation"
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of last state update"
    }
  }
}
