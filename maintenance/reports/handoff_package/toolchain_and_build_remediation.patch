-+---
-+title: "Bankr Plugin"
-+description: "Discover and buy newly launched tokens on Bankr."
-+tags: [token-launches, trading, memecoins, discovery]
-+name: bankr
-+version: 0.2.0
-+integration: http-api
-+chains: [base]
-+requires:
-+  shell: none
