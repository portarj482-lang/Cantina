{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QRPEInputSchema",
  "type": "object",
  "required": ["mode", "target_root"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["AUDIT", "PLAN", "GENERATE", "EXECUTE", "REPAIR", "VERIFY", "FULL_RECONCILIATION"]
    },
    "target_root": {
      "type": "string",
      "description": "Path to repository or bounty root"
    },
    "bounty_slug": {
      "type": "string"
    },
    "pack_name": {
      "type": "string",
      "enum": ["pack-a-source", "pack-b-static", "pack-c-dynamic", "pack-d-symbolic", "pack-e-triage", "pack-f-review", "pack-g-solana", "all"]
    },
    "dry_run": {
      "type": "boolean",
      "default": true
    },
    "confirm": {
      "type": "boolean",
      "default": false
    }
  }
}
