# USAP OpenAI Reasoning Provider Configuration Example
# All credentials should be provided via environment variables or secret manager.
# NEVER commit live API keys to source control.

# Required: API key for OpenAI authentication (Redacted template)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Model Selection: "o3-mini", "o1", "o1-mini", "gpt-4o", "gpt-4o-mini"
OPENAI_MODEL=gpt-4o-mini

# Reasoning Effort (Only valid for o-series models: "low", "medium", "high")
OPENAI_REASONING_EFFORT=high

# Network and Resilience Limits
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=4
OPENAI_MAX_OUTPUT_TOKENS=4096

# Privacy & Compliance: Do not permit remote server response storage for training
OPENAI_STORE_RESPONSES=false

# Provider Selection: "openai"
USAP_REASONING_PROVIDER=openai

# Fallback Behavior: "none" (fail closed) or local rule heuristic
USAP_OPENAI_FALLBACK_PROVIDER=none

# Optional: Endpoint override (e.g. enterprise proxy or Azure OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1
