{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HallucinationAudit",
  "type": "object",
  "required": [
    "slug",
    "pinned_commit",
    "timestamp",
    "status",
    "citations_audited",
    "dropped_count"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "pinned_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "timestamp": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["ALL_CITATIONS_VERIFIED", "CITATIONS_FLAGGED", "NO_CITATIONS_FOUND"]
    },
    "citations_audited": {
      "type": "integer",
      "minimum": 0
    },
    "verified_count": {
      "type": "integer",
      "minimum": 0
    },
    "dropped_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "start_line", "end_line", "reported_in", "status"],
        "properties": {
          "target": {"type": "string"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "reported_in": {"type": "string"},
          "status": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "unverified_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "start_line", "end_line", "reported_in", "code", "message"],
        "properties": {
          "target": {"type": "string"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "reported_in": {"type": "string"},
          "code": {"type": "string"},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "invalid_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw", "error"],
        "properties": {
          "raw": {"type": "string"},
          "error": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "skipped_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "reason"],
        "properties": {
          "source": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
