+name: Security Mesh CI
+
+on:
+  push:
+    paths:
+      - 'security-mesh/**'
+  pull_request:
+    paths:
+      - 'security-mesh/**'
+  workflow_dispatch:
+    inputs:
+      db_integration:
+        description: 'Set to true to run Postgres service container integration tests'
+        required: false
+        default: 'false'
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  lint-node:
+    name: Security Mesh TypeScript & Node Lint
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: security-mesh
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js 20
+        uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: 'npm'
+          cache-dependency-path: 'security-mesh/package-lock.json'
+
+      - name: Install dependencies
+        run: npm ci
+
+      - name: Typecheck TypeScript
+        run: npx tsc --noEmit
+
+  db-integration:
+    name: Postgres Service Integration Tests
+    runs-on: ubuntu-latest
+    needs: lint-node
+    # Require DB_INTEGRATION=true or manual dispatch flag or label
+    if: |
+      github.event.inputs.db_integration == 'true' ||
+      env.DB_INTEGRATION == 'true' ||
+      contains(github.event.pull_request.labels.*.name, 'run-db-tests')
+    env:
+      DB_INTEGRATION: "true"
+      DATABASE_URL: "postgresql://postgres:postgres@localhost:5432/cantina_audit"
+
+    services:
+      postgres:
+        image: postgres:15-alpine
+        env:
+          POSTGRES_USER: postgres
+          POSTGRES_PASSWORD: postgres
+          POSTGRES_DB: cantina_audit
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd pg_isready
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+
+    defaults:
+      run:
+        working-directory: security-mesh
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js 20
+        uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: 'npm'
+          cache-dependency-path: 'security-mesh/package-lock.json'
+
+      - name: Install dependencies
+        run: npm ci
+
+      - name: Run Postgres Migrations
+        run: |
+          if [ -d "migrations" ]; then
+            for sql in migrations/*.sql; do
+              if [ -f "$sql" ]; then
+                PGPASSWORD=postgres psql -h localhost -U postgres -d cantina_audit -f "$sql" || true
+              fi
+            done
+          fi
+
+      - name: Run E2E Integration Tests
+        run: |
+          npm run test:e2e || node test-e2e.mjs
